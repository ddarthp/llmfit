# Models and binaries: ~23 GB. These never go into Git. They are downloaded on
# first use and verified by SHA-256 from config/models.json and config/backends.json.
models/
downloads/
tools/
.gopath/

# Local runtime state
.atl/
.pi/
llama-server.pid
llama-server.log
llama-server.err.log
llmfit-panel.log
llmfit-fetch.log

# What the panel is doing right now: which configuration was asked for and how
# far its downloads got. Both are rewritten on every run and mean nothing on
# another machine.
.llmfit-ui-state.json
.llmfit-ui-progress.json

# Backups llmfit.ps1 makes before touching your harness configuration
*.llmfit-backup
