# Normalize to LF inside the repository.
* text=auto eol=lf

# Windows launchers keep CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf

# macOS and Linux launchers must keep LF: no shell will run a script whose
# shebang line ends in CR.
*.command text eol=lf
*.sh text eol=lf
*.zsh text eol=lf

# The panel is served as-is; CRLF in the JavaScript would work but the diffs
# would not.
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
